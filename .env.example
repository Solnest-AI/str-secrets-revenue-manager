# Filled on summit morning by the STR Secrets connections kit (fan-out-env.sh copies the
# attendee's keys here). Never paste keys into the chat; never commit the filled .env.
HOSPITABLE_API_KEY=
PRICELABS_API_KEY=
AIRROI_API_KEY=
# IntelliHost fallback token (only if the browser sign-in is not used); optional
INTELLIHOST_MCP_TOKEN=
# Guesty / OwnerRez, only if that is your PMS
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
OWNERREZ_EMAIL=
OWNERREZ_TOKEN=
# Hostaway (Settings > Hostaway API > Create; both shown once) / Lodgify (Settings > Public API),
# only if that is your PMS
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=
LODGIFY_API_KEY=
# Uplisting, only if that is your PMS (Connect > API; the key alone, no colon)
UPLISTING_API_KEY=
# Smoobu, only if that is your PMS (Settings > Advanced > API Keys; the secret is shown once).
# Both are required: every Smoobu call is HMAC-signed, the legacy single key is being switched off.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
# Hostfully, only if that is your PMS (Agency Settings: API Key field, Agency UID at the bottom)
HOSTFULLY_API_KEY=
HOSTFULLY_AGENCY_UID=
